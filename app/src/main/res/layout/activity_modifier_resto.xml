<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modifier le Restaurant"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etNomResto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nom du restaurant"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etSiret"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="N° SIRET"
            android:inputType="number"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etAdresse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Adresse"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCP"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Code Postal"
                android:inputType="number"
                android:background="@android:color/white"
                android:padding="10dp"
                android:layout_marginEnd="5dp"/>

            <EditText
                android:id="@+id/etCommune"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:hint="Commune"
                android:background="@android:color/white"
                android:padding="10dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnEnregistrerResto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="METTRE À JOUR LE PROFIL"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="30dp"/>

    </LinearLayout>
</ScrollView>