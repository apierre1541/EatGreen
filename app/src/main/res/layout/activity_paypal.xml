<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_send"
        android:layout_marginBottom="20dp"
        android:contentDescription="PayPal Logo Placeholder" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lier votre compte PayPal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#003087"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entrez l'adresse email de votre compte"
        android:layout_marginBottom="20dp"
        android:textColor="#666666"/>

    <EditText
        android:id="@+id/etEmailPaypal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="exemple@mail.com"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnEnregistrerPaypal"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Enregistrer PayPal"
        android:backgroundTint="#0070BA"
        android:textColor="#FFFFFF" />

</LinearLayout>