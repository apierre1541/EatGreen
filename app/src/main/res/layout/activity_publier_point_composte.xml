<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_centerVertical="true">
        <EditText
            android:id="@+id/nom_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Entrer le nom du point (ex : Composte sud)"
            android:inputType="text"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Ajouter la description du point"
            android:inputType="text"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/latitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Ajouter la latitude du point"
            android:inputType="text"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/longitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Ajouter la longitude du point"
            android:inputType="text"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Ajouter l'adresse"
            android:inputType="text"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/code_postal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Ajouter le code postal"
            android:inputType="number"
            android:layout_marginTop="16dp"/>
        <EditText
            android:id="@+id/ville"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ems="10"
            android:hint="Ajouter la ville"
            android:inputType="text" />
        <EditText
        android:id="@+id/type_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Ajouter le mot composte (Composte)"
        android:inputType="text" />
        <Button
            android:id="@+id/b7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter le point" />
    </LinearLayout>
</RelativeLayout>