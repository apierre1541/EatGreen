<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========================================== -->
        <!-- HEADER AVEC LOGO TRÈS GRAND CENTRÉ - FOND BLANC -->
        <!-- ========================================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#4CAF50">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <!-- LOGO AVEC FOND BLANC (120dp) -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/logo_eatgreen"
                    android:contentDescription="Logo EatGreen"
                    android:elevation="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/circle_background_white"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EatGreen"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bon appétit !"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:alpha="0.9"
                    android:layout_marginBottom="16dp" />

                <!-- Badge de points en bas -->
                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="125 pts"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_rounded"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- PROFIL UTILISATEUR -->
        <!-- ========================================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_margin="16dp"
            android:layout_marginTop="-30dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgUser"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_person"
                    app:tint="#4CAF50"
                    android:background="@drawable/circle_background"
                    android:padding="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahmadou Diaw"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ahmadou.diaw@etu.unilim.fr"
                        android:textSize="14sp"
                        android:textColor="#757575" />
                </LinearLayout>

                <!-- BOUTON PROFIL -->
                <Button
                    android:id="@+id/btnEditerProfil"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="#4CAF50"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- SECTION TITRE -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍱 Paniers du jour"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp" />

        <!-- ========================================== -->
        <!-- PANIERS DISPONIBLES -->
        <!-- ========================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <!-- Panier 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="#FFF8E1"
                            android:src="@drawable/ic_restaurant"
                            android:scaleType="center"
                            android:padding="20dp"
                            app:tint="#4CAF50" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Le Gourmet"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#212121" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 paniers disponibles"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8.50€"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#4CAF50"
                                    android:layout_weight="1" />

                                <Button
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:text="Voir"
                                    android:textSize="12sp"
                                    android:backgroundTint="#4CAF50"
                                    style="@style/Widget.MaterialComponents.Button" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Panier 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="#E8F5E9"
                            android:src="@drawable/ic_restaurant"
                            android:scaleType="center"
                            android:padding="20dp"
                            app:tint="#4CAF50" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bio &amp; Co"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#212121" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 paniers disponibles"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="9.50€"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#4CAF50"
                                    android:layout_weight="1" />

                                <Button
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:text="Voir"
                                    android:textSize="12sp"
                                    android:backgroundTint="#4CAF50"
                                    style="@style/Widget.MaterialComponents.Button" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Panier 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="#FFEBEE"
                            android:src="@drawable/ic_restaurant"
                            android:scaleType="center"
                            android:padding="20dp"
                            app:tint="#4CAF50" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saveurs du Monde"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#212121" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 paniers disponibles"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="7.90€"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#4CAF50"
                                    android:layout_weight="1" />

                                <Button
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:text="Voir"
                                    android:textSize="12sp"
                                    android:backgroundTint="#4CAF50"
                                    style="@style/Widget.MaterialComponents.Button" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ========================================== -->
        <!-- SECTION AUTOUR DE MOI -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Restaurants à proximité"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvVoirTousRestos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voir tout"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Restaurant proche 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_margin="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_restaurant"
                    android:tint="#4CAF50"
                    android:background="@drawable/circle_background_light"
                    android:padding="10dp"
                    tools:ignore="UseAppTint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Le Gourmet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurant Universitaire • 200m"
                        android:textSize="12sp"
                        android:textColor="#757575" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.50€"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 paniers"
                        android:textSize="11sp"
                        android:textColor="#999999" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Restaurant proche 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_restaurant"
                    android:tint="#4CAF50"
                    android:background="@drawable/circle_background_light"
                    android:padding="10dp"
                    tools:ignore="UseAppTint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bio &amp; Co"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurant Bio • 450m"
                        android:textSize="12sp"
                        android:textColor="#757575" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9.50€"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 paniers"
                        android:textSize="11sp"
                        android:textColor="#999999" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- SECTION JARDINAGE -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 Ateliers jardinage"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp" />

        <!-- Session 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_margin="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Initiation au jardinage bio"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samedi 15 mars • 14h00"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jardin partagé - Campus"
                        android:textSize="12sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:minWidth="70dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/12"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <Button
                        android:id="@+id/btnInscrireJardinage1"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Réserver"
                        android:textSize="11sp"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Session 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atelier compostage"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mercredi 19 mars • 16h30"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maison des étudiants"
                        android:textSize="12sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:minWidth="70dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8/15"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <Button
                        android:id="@+id/btnInscrireJardinage2"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Réserver"
                        android:textSize="11sp"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- SERVICES - GRILLE AVEC BOUTONS (STABLES) -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Services"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <!-- BOUTON PRÉFÉRENCE (Button standard) -->
            <Button
                android:id="@+id/btnPreference"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:text="Préférences"
                android:textSize="12sp"
                app:icon="@drawable/ic_preference"
                app:iconGravity="top"
                app:iconPadding="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#4CAF50"
                app:strokeColor="#4CAF50" />

            <!-- BOUTON PROGRAMME (Button standard) -->
            <Button
                android:id="@+id/btnProgramme"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_marginBottom="8dp"
                android:text="UnilimBio"
                android:textSize="12sp"
                app:icon="@drawable/ic_programme"
                app:iconGravity="top"
                app:iconPadding="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#4CAF50"
                app:strokeColor="#4CAF50" />

            <!-- BOUTON CARTE (Button standard) -->
            <Button
                android:id="@+id/btnCarte"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:text="Carte composte"
                android:textSize="12sp"
                app:icon="@drawable/ic_carte"
                app:iconGravity="top"
                app:iconPadding="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#4CAF50"
                app:strokeColor="#4CAF50" />

            <!-- BOUTON RESTAURANT (Button standard) -->
            <Button
                android:id="@+id/btnRestaurant"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:text="Restaurants"
                android:textSize="12sp"
                app:icon="@drawable/ic_restaurant"
                app:iconGravity="top"
                app:iconPadding="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#4CAF50"
                app:strokeColor="#4CAF50" />
        </GridLayout>

        <!-- ========================================== -->
        <!-- BOUTON DÉCONNEXION -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnDeconnexion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Déconnexion"
                android:textSize="14sp"
                android:textColor="#F44336"
                app:strokeColor="#F44336"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="8dp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- BARRE DE NAVIGATION -->
        <!-- ========================================== -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:elevation="8dp"
            app:itemIconTint="@color/green_primary"
            app:itemTextColor="@color/green_primary"
            app:menu="@menu/bottom_navigation_menu" />

    </LinearLayout>
</ScrollView>