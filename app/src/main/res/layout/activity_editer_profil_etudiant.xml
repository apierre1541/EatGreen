<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Éditer le profil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="20dp"/>

        <EditText android:id="@+id/etNom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Nom" android:inputType="textPersonName" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etPrenom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Prénom" android:inputType="textPersonName" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etTelephone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Téléphone" android:inputType="phone" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etMail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Mail" android:inputType="textEmailAddress" android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode de paiement :"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <CheckBox android:id="@+id/cbCarteBancaire" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CB"/>
        <CheckBox android:id="@+id/cbPaypal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PayPal" android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnSupprimerCompte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Supprimer Compte"
                android:backgroundTint="#F44336"
                android:layout_marginEnd="5dp"/>

            <Button
                android:id="@+id/btnEnregistrer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enregistrer"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="5dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
