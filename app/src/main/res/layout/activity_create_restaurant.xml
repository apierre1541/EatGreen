<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4CAF50">

    <!-- En-tête -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer mon restaurant"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Formulaire -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:paddingTop="10dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="10dp"
            android:layout_margin="16dp"
            android:layout_marginTop="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informations du restaurant"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center"/>

            <!-- Nom du restaurant -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint=" Nom du restaurant"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#4CAF50"
                app:hintTextColor="#4CAF50"
                app:startIconDrawable="@drawable/ic_restaurant"
                app:startIconTint="#4CAF50">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNomRestaurant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="45dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- N° SIRET -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint=" N° SIRET (14 chiffres)"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#4CAF50"
                app:hintTextColor="#4CAF50"
                app:startIconDrawable="@drawable/ic_siret"
                app:startIconTint="#4CAF50"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSiret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="14"
                    android:paddingStart="45dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Adresse -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint=" Adresse"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#4CAF50"
                app:hintTextColor="#4CAF50"
                app:startIconDrawable="@drawable/ic_address"
                app:startIconTint="#4CAF50">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAdresse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="45dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Code postal et commune -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint=" Code postal"
                    android:layout_marginEnd="8dp"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    app:startIconDrawable="@drawable/ic_postal"
                    app:startIconTint="#4CAF50">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodePostal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingStart="45dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint=" Commune"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    app:startIconDrawable="@drawable/ic_city"
                    app:startIconTint="#4CAF50">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCommune"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="45dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Message d'information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Après validation, votre restaurant sera soumis à l'approbation d'un administrateur."
                android:textColor="#666666"
                android:textSize="12sp"
                android:padding="10dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="20dp"/>

            <!-- Bouton Créer -->
            <Button
                android:id="@+id/btnCreateRestaurant"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CRÉER MON RESTAURANT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>